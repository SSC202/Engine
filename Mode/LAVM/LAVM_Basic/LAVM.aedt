				VariableProp('T_fri', 'UD', '', '4mNewtonMeter')
				VariableProp('cal_num', 'UD', '', '75')
				VariableProp('coil_L', 'UD', '', '(4*((HS_2+y0)/2)+2*model_length*1.5)*cal_num')
				VariableProp('d_line', 'UD', '', '0.26mm')
				VariableProp('coil_S', 'UD', '', 'd_line*d_line/4*pi')
